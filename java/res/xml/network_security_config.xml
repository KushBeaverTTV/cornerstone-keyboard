<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is denied by default. The host below is a placeholder; the
     Gradle F-5 gate fails the build if AGENT_KEY_ENDPOINT is http:// and
     its host is not listed here. Put the real Tailscale hostname in this
     allowlist when pairing a mesh endpoint via local.properties. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">tailscale-mesh-host.local</domain>
    </domain-config>
</network-security-config>
