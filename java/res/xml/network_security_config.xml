<?xml version="1.0" encoding="utf-8"?>
<!-- Agent Key prototype: the VPS endpoint lives on the Tailscale mesh and is
     reached over plain HTTP (the mesh itself is encrypted). Permit cleartext
     for that host ONLY; everything else stays blocked. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">100.100.194.62</domain>
    </domain-config>
</network-security-config>
